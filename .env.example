# Porta HTTP (o Render define automaticamente)
PORT=3000

# Pasta onde o banco JSON (db.json + snapshots.json) é salvo.
# No Render aponte para o disco persistente (/var/data).
DATA_DIR=./data

# URL pública da aplicação, usada nos links de teste gerados pelo verificador.
# Se vazio, usa o host da requisição.
APP_URL=

# Opcional (não usado hoje pelo servidor)
GEMINI_API_KEY=

# Postgres externo (obrigatório no Render Free). Ex.: Neon
# DATABASE_URL=postgresql://usuario:senha@ep-xxx.neon.tech/neondb?sslmode=require
